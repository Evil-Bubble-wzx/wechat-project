<view class="app {{isTab ? 'is-tab' : ''}} {{route === 'player' ? 'player-theme' : ''}}">
  <view class="nav" style="padding-top: {{inset}}px">
    <view class="nav-left" wx:if="{{!isTab}}" bindtap="back"><image class="icon" src="/assets/icon-back.png" /></view>
    <view class="brand" wx:if="{{route === 'home'}}"><image src="/assets/icon-book.png" class="icon" /><text>听阅</text><text class="brand-en">TINGYUE</text></view>
    <text class="nav-title" wx:if="{{route !== 'home'}}">{{title}}</text>
    <view class="wx-capsule"><text>•••</text><text class="capsule-divider">│</text><text>◉</text></view>
  </view>

  <view class="content home" wx:if="{{route === 'home'}}">
    <view class="greeting"><view><text class="eyebrow">A LITTLE READING, EVERY DAY</text><view class="greeting-title">让每个故事，陪你长大<text class="tiny-spark">✳</text></view></view></view>
    <view class="search-box" bindtap="search"><image class="icon" src="/assets/icon-search.png" /><text>Title / Series / Author / No.</text><text class="search-short">Search</text></view>
    <view class="hero" data-page="detail" data-id="peter" bindtap="nav">
      <view class="hero-copy"><text class="hero-label">WEEKLY PICK</text><view class="hero-title"><view>走进故事里，</view><view>听见大世界。</view></view><text class="hero-desc">从《彼得兔》开始一场花园奇遇</text><view class="hero-cta">Read for Me <image src="/assets/icon-arrow-white.png" class="icon small" /></view></view>
      <view class="hero-art"><view class="hero-orbit"></view><text class="hero-star">✦</text><image src="/assets/peter.png" class="hero-book" mode="aspectFill" /><view class="hero-pill"><image class="icon tiny" src="/assets/icon-headphones.png" /> A 5-minute adventure</view><text class="hero-star second">✧</text></view>
    </view>
    <view class="quick-links">
      <view data-page="library" bindtap="nav"><view class="quick-icon sage"><image src="/assets/icon-book.png" /></view><text>Find Books</text></view>
      <view data-page="loans" bindtap="nav"><view class="quick-icon peach"><image src="/assets/icon-bag.png" /></view><text>Borrowed</text></view>
      <view data-page="recent" bindtap="nav"><view class="quick-icon blue"><image src="/assets/icon-headphones.png" /></view><text>Recent</text></view>
      <view data-page="report" bindtap="nav"><view class="quick-icon lavender"><image src="/assets/icon-chart.png" /></view><text>My Quizzes</text></view>
      <view data-page="ranking" bindtap="nav"><view class="quick-icon butter"><image src="/assets/icon-trophy.png" /></view><text>Rankings</text></view>
    </view>
    <view class="notice" data-page="loans" bindtap="nav"><image src="/assets/icon-pin.png" class="icon" /><view><text class="notice-title">把故事带回家</text><text class="notice-sub">示例阅读馆 · 09:30–18:30 · 到馆借还</text></view><image src="/assets/icon-arrow.png" class="icon small" /></view>
    <view class="section-head"><view><text class="section-title">Books</text><text class="section-en">FIND YOUR NEXT STORY</text></view><text class="more" data-page="library" bindtap="nav">View all ›</text></view>
    <text class="catalog-disclaimer">Sample catalog · Metadata pending verification</text>
    <view class="book-row catalog-row home-book" wx:for="{{books}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">Series</text><text>{{item.series}}</text></view><view class="catalog-level"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">No.</text><text>{{item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view>
    <view class="footer-note">READ A LITTLE. GROW A LITTLE.</view>
  </view>

  <view class="content" wx:if="{{route === 'library'}}">
    <view class="page-heading">Find Books<text class="heading-caption">在这里，遇见属于你的好故事</text></view>
    <view class="search-box"><image class="icon" src="/assets/icon-search.png" /><input placeholder="Title / Series / Author / No." value="{{query}}" bindinput="inputSearch" /></view>
    <view class="filters"><view wx:for="{{filters}}" wx:key="id" class="chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseFilter">{{item.label}}</view></view>
    <view class="list-label">{{shown.length}} books<text>Featured</text></view>
    <view class="book-row catalog-row library-card" wx:for="{{shown}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">Series</text><text>{{item.series}}</text></view><view class="catalog-level"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">No.</text><text>{{item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view>
    <view class="empty" wx:if="{{!shown.length}}"><image src="/assets/icon-search.png" /><text>没有找到这本书</text><text class="muted">试试作者名，或换一个关键词</text></view>
  </view>

  <view class="content" wx:if="{{route === 'detail'}}">
    <view class="detail-hero" style="background: {{book.color}}"><view class="detail-halo"></view><image class="detail-cover" src="{{book.cover}}" mode="aspectFill" /><text class="detail-series">TINGYUE CLASSICS · 听阅精选</text></view>
    <view class="detail-title-line"><view><text class="tag">{{book.series}}</text><view class="detail-title">{{book.title}}</view><text class="muted">{{book.author}}</text></view><view class="favorite {{currentFavorite ? 'selected' : ''}}" bindtap="toggleFavorite"><image src="/assets/icon-heart.png" /><text>{{currentFavorite ? 'Saved' : 'Favorite'}}</text></view></view>
    <view class="metrics"><view><text>{{book.level}}</text><text>Level</text></view><view><text>{{book.words}}</text><text>Words</text></view><view><text>{{book.pages}}</text><text>Pages</text></view><view><text>{{book.time}}</text><text>Listening</text></view></view>
    <view class="catalog-meta detail-metadata"><view><text class="meta-label">No.</text><text>{{book.number}}</text></view><view><text class="meta-label">Words</text><text>{{book.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{book.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view><text class="meta-label">Pages</text><text>{{book.pages}}</text></view></view>
    <view class="section-head"><text class="section-title">About this book</text><text class="tag">{{book.category === 'fiction' ? 'FICTION' : 'NONFICTION'}}</text></view><text class="description">{{book.desc}}</text>
    <view class="duo-actions"><button class="primary" bindtap="startPlayer"><image src="/assets/icon-headphones-white.png" class="icon" /> Read for Me</button><button class="secondary" bindtap="openQuiz"><image src="/assets/icon-check.png" class="icon" /> Take Quiz</button></view>
    <view wx:if="{{book.chapters}}"><view class="section-head"><text class="section-title">Chapters</text><text class="tag">{{book.chapters.length}} AUDIO</text></view><view class="queue-row" wx:for="{{book.chapters}}" wx:key="id" data-id="{{item.id}}" bindtap="startChapter"><image class="mini-cover" src="{{book.cover}}" /><text>{{item.title}}</text><text class="muted">▶</text></view></view>
    <view class="borrow-panel"><view class="panel-top"><image class="icon" src="/assets/icon-bag.png" /><text>把纸质书带回家</text><text class="tag">{{book.stock ? 'Available' : 'Unavailable'}}</text></view><view class="branch-line"><view><text>听阅 · 示例阅读馆</text><text class="muted">At the library / 归还 · 示例借期 14 天</text></view><text class="stock">{{book.stock}}<text>available</text></text></view><button class="secondary full" bindtap="openReserve" disabled="{{!book.stock}}">{{book.stock ? 'Reserve a copy' : 'No copies available'}}</button></view>
    <text class="demo-caption">样例书目与库存 · 正式内容上线后替换</text>
  </view>

  <view class="content" wx:if="{{route === 'loans'}}">
    <view class="loan-summary"><view><text class="eyebrow">MY LITTLE LIBRARY</text><view class="white-title">好书，借回家慢慢读。</view><text class="soft-white">每次借阅，都是一场新的相遇</text></view><image src="/assets/icon-bag-white.png" class="summary-icon" /><view class="loan-summary-bottom"><text>Active reservations & loans</text><text>{{totalLoans}}<text class="unit"> 本</text></text></view></view>
    <view class="filters loan-filters"><view wx:for="{{loanTabs}}" wx:key="id" class="chip {{loanFilter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="loanFilter">{{item.label}}</view></view>
    <view class="loan-card" wx:for="{{loanList}}" wx:key="id"><view class="panel-top"><text>听阅 · 示例阅读馆</text><text class="tag">{{item.label}}</text></view><view class="loan-book"><image src="{{item.book.cover}}" class="row-cover" /><view><text class="row-title">{{item.book.title}}</text><text class="muted">{{item.book.title}}</text><text class="loan-date">{{item.due}}</text></view></view><view class="loan-bottom"><text class="muted">演示预约 · 无真实占库</text><button wx:if="{{item.status === 'reserved'}}" class="small-button" data-id="{{item.id}}" bindtap="cancelLoan">Cancel</button><button wx:if="{{item.status === 'borrowed'}}" class="small-button" data-id="{{item.id}}" bindtap="renewLoan">Renew</button></view></view>
    <view class="empty illustrated-empty" wx:if="{{!loanList.length}}"><view class="empty-books"><image src="/assets/willow.png" /><image src="/assets/peter.png" /></view><text>留一个位置，给下一本好书</text><text class="muted">{{user ? '你的预约和借阅记录，会出现在这里' : '登录后，就能预约喜欢的实体书'}}</text><button class="primary" data-page="{{user ? 'library' : 'login'}}" bindtap="nav">{{user ? 'Find Books' : 'Log in to borrow'}}</button></view>
    <view class="info-note"><image src="/assets/icon-clock.png" class="icon" /><text>借阅须知：示例规则为借期 14 天，可续借 1 次。正式规则由阅读馆配置。</text></view>
  </view>

  <view class="content" wx:if="{{route === 'me'}}">
    <view class="member-card"><view class="member-top"><view class="avatar">{{user ? '阅' : 'Hi'}}</view><view><text class="member-name">{{user ? user.name : '你好，小小阅读家'}}</text><text class="soft-white">{{user ? 'A new discovery, every day' : '登录后，收藏你的成长故事'}}</text></view><image data-sheet="settings" bindtap="showSheet" src="/assets/icon-settings-white.png" class="icon" /></view><view class="member-type">TINGYUE READER<text>Reader Card</text></view><view class="member-bottom"><text>{{user ? '演示账户 · 无正式借阅资格' : '你的阅读旅程，从这里开始'}}</text><button wx:if="{{!user}}" class="login-mini" data-page="login" bindtap="nav">Log in / Sign up →</button><text wx:if="{{user}}">DEMO</text></view></view>
    <view class="metrics profile-metrics"><view><text>{{stats.pieces}}</text><text>BOOKS</text></view><view><text>{{stats.words}}</text><text>WORDS</text></view><view><text>{{results.length}}</text><text>QUIZZES</text></view></view>
    <view class="section-head"><text class="section-title">My Reading</text><text class="section-en">MY READING</text></view>
    <view class="menu-card"><view class="menu-row" data-page="report" bindtap="nav"><image src="/assets/icon-chart.png" /><text>My Quizzes</text><text class="menu-hint">Your progress</text><text>›</text></view><view class="menu-row" data-page="recent" bindtap="nav"><image src="/assets/icon-clock.png" /><text>Recent</text><text class="menu-hint">{{recent.length}} 本</text><text>›</text></view><view class="menu-row" data-sheet="favorites" bindtap="showSheet"><image src="/assets/icon-heart.png" /><text>Favorite Books</text><text class="menu-hint">{{favorites.length}} 本</text><text>›</text></view><view class="menu-row" data-sheet="words" bindtap="showSheet"><image src="/assets/icon-book.png" /><text>Vocabulary</text><text class="menu-hint">New words</text><text>›</text></view></view>
    <view class="menu-card"><view class="menu-row" data-page="loans" bindtap="nav"><image src="/assets/icon-bag.png" /><text>Borrowed</text><text class="menu-hint">{{totalLoans}} 本</text><text>›</text></view><view class="menu-row" data-page="ranking" bindtap="nav"><image src="/assets/icon-trophy.png" /><text>Rankings</text><text class="menu-hint">Grow together</text><text>›</text></view><view class="menu-row" data-sheet="branch" bindtap="showSheet"><image src="/assets/icon-pin.png" /><text>My Library</text><text class="menu-hint">示例馆</text><text>›</text></view></view><view class="footer-note">听阅 TINGYUE · FRONTEND DEMO 0.1</view>
  </view>

  <view class="content" wx:if="{{route === 'recent'}}"><view class="page-heading">Recent<text class="heading-caption">{{recent.length}} books · Pick up a favorite story</text></view><view class="book-row catalog-row " wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">Series</text><text>{{item.series}}</text></view><view class="catalog-level"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">No.</text><text>{{item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view><view class="empty" wx:if="{{!recent.length}}"><image src="/assets/icon-headphones.png" /><text>Your first story is waiting</text><button class="primary" data-page="library" bindtap="nav">Find Books</button></view></view>

  <view class="player-content" wx:if="{{route === 'player'}}"><text class="player-eyebrow">TAKE A BREATH. ENJOY THE STORY.</text><image src="{{book.cover}}" class="player-cover" mode="aspectFill" /><view class="player-title">{{book.chapterTitle || book.title}}</view><text class="player-author">{{book.author}}</text><view class="subtitle-toggle" bindtap="toggleSubtitle">{{subtitle ? 'Subtitles on' : 'Subtitles off'}} <text>{{subtitle ? '●' : '○'}}</text></view><view class="subtitle" wx:if="{{subtitle}}"><text class="muted">完整时间轴草稿 · 待人工复核</text><view class="subtitle-line" wx:if="{{activeCue}}"><block wx:if="{{activeCue.tokens.length}}" wx:for="{{activeCue.tokens}}" wx:key="id"><text wx:if="{{item.vocabKey}}" bindtap="word" data-word="{{item.surface}}" data-vocab-key="{{item.vocabKey}}" class="word-link">{{item.surface}}</text><text wx:else>{{item.surface}}</text></block><text wx:if="{{!activeCue.tokens.length}}">{{activeCue.text}}</text></view><text class="subtitle-pause" wx:if="{{!activeCue}}">…</text></view><view class="player-space" wx:if="{{!subtitle}}"><text>让耳朵，带你走进故事。</text></view><slider min="0" max="{{book.duration}}" value="{{position}}" activeColor="#a8cdb2" backgroundColor="#456052" block-size="16" bindchange="seek" /><view class="time-row"><text>{{formatted}}</text><text>{{duration}}</text></view><view class="player-controls"><view bindtap="speed" class="speed">{{rate}}×</view><view data-step="-1" bindtap="nextTrack" class="skip">Ⅰ◀</view><button class="play-button" bindtap="togglePlay"><image src="/assets/icon-{{playing ? 'pause' : 'play'}}.png" /></button><view data-step="1" bindtap="nextTrack" class="skip">▶Ⅰ</view><view data-sheet="queue" bindtap="showSheet"><image src="/assets/icon-list-white.png" class="icon" /></view></view><view class="player-tools"><text bindtap="loop">{{loop ? '↻ Repeat one' : '↻ In order'}}</text><text bindtap="openQuiz">Take Quiz →</text></view><text class="player-demo">{{book.localAudio || book.audioUrl ? '已导入音频 · ' + book.audioSource : '界面演示 · 音频待导入'}}</text></view>

<view class="content" wx:if="{{route === 'login'}}"><view class="login-art"><image src="/assets/peter.png" /><image src="/assets/garden.png" /><text>✳</text></view><view class="login-title"><view>每一个故事，</view><view>都值得一起读。</view></view><text class="login-desc">欢迎来到听阅 · 把成长读成一本书</text><view class="login-tabs"><view class="{{loginMethod === 'wechat' ? 'active' : ''}}" bindtap="loginMethod" data-id="wechat">WeChat Login</view><view class="{{loginMethod === 'phone' ? 'active' : ''}}" bindtap="loginMethod" data-id="phone">Phone Login</view></view><view wx:if="{{loginMethod === 'phone'}}"><view class="input-box"><text>+86</text><input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="phoneInput" /></view><view class="input-box"><input type="number" maxlength="6" placeholder="短信验证码" value="{{code}}" bindinput="codeInput" /><text class="green" bindtap="sendCode">{{codeSent ? 'Demo: 123456' : 'Get Code'}}</text></view></view><button class="primary full login-button" bindtap="login"><image wx:if="{{loginMethod === 'wechat'}}" src="/assets/icon-wechat-white.png" class="icon" />{{loginMethod === 'wechat' ? 'WeChat Login · Demo' : 'Phone Login · Demo'}}</button><view class="agreement"><view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="agreement">{{agreed ? '✓' : ''}}</view><text bindtap="agreement">I agree to</text><text class="green" data-sheet="terms" bindtap="showSheet">Terms</text><text class="green" data-sheet="privacy" bindtap="showSheet">Privacy</text></view><text class="demo-caption">当前为交互演示，不发送短信、不获取微信身份。{{'\n'}}请使用测试手机号，演示验证码为 123456。</text><view class="guest-link" data-page="home" bindtap="nav">Browse as a guest →</view></view>

  <view class="content" wx:if="{{route === 'report'}}"><view class="page-heading">每一步，都算数。<text class="heading-caption">My Quizzes · 本机演示记录</text></view><view class="report-hero"><text>保持好奇，就是最好的开始</text><view class="report-large">{{stats.pieces}}<text>篇已完成</text></view><view class="report-caption">每读完一个故事，世界就大一点。</view></view><view class="report-grid"><view><text class="muted">Total Words</text><text class="report-value">{{stats.words}}</text></view><view><text class="muted">Avg. Correct</text><text class="report-value">{{stats.correct}}<text>%</text></text></view></view><view class="section-head"><text class="section-title">Your Progress</text><text class="tag">EARLY → RECENT</text></view><view class="chart-empty"><image src="/assets/icon-chart.png" /><text>慢慢积累，进步自会出现</text><text class="muted">完成至少 6 篇后，展示早期与近期表现对比</text><view class="chart-bars"><view></view><view></view><view></view><view></view><view></view><view></view></view></view><view class="section-head"><text class="section-title">Quiz History</text><text class="muted">{{results.length}} 次</text></view><view class="result-row" wx:for="{{results}}" wx:key="id"><view><text class="row-title">{{item.title}}</text><text class="muted">{{item.date}}</text></view><text class="result-score">{{item.score}}%</text></view><view class="small-empty" wx:if="{{!results.length}}">Listen to Peter Rabbit, then take your first quiz.</view></view>

  <view class="content" wx:if="{{route === 'ranking'}}"><view class="rank-header"><text class="eyebrow">GROW TOGETHER</text><view class="rank-title">与好故事，一起成长。</view><text class="muted">每一次认真阅读，都值得一颗小星星</text><image src="/assets/icon-trophy.png" /></view><view class="login-tabs"><view class="{{period === 'week' ? 'active' : ''}}" bindtap="period" data-id="week">Last 7 Days</view><view class="{{period === 'all' ? 'active' : ''}}" bindtap="period" data-id="all">All Time</view></view><view class="empty"><text>你的第一位对手，是昨天的自己。</text><text class="muted">{{period === 'week' ? 'Last 7 Days榜单' : '累计榜单'}}尚未接入真实读者数据</text><button class="primary" data-page="library" bindtap="nav">开始今天的阅读</button></view><view class="rank-self"><view class="avatar">阅</view><view><text>{{user ? user.name : '小小阅读家'}}</text><text class="muted">完整榜单上线后展示真实排名</text></view><text>—</text></view></view>

  <view class="content quiz-content" wx:if="{{route === 'quiz'}}"><text class="eyebrow">A LITTLE QUIZ, A BIG DISCOVERY</text><view wx:if="{{!result}}"><view class="quiz-heading">Take Quiz<text>{{questionIndex + 1}} / {{quizTotal}}</text></view><view class="progress-track"><view style="width: {{(questionIndex + 1) * 20}}%"></view></view><text class="tag">THE TALE OF PETER RABBIT · 示例测验</text><view class="question">{{question.q}}</view><text class="muted">{{question.zh}}</text><view class="answer {{answer === index ? 'selected' : ''}}" wx:for="{{question.options}}" wx:key="*this" data-index="{{index}}" bindtap="answer"><text class="answer-letter">{{index === 0 ? 'A' : index === 1 ? 'B' : 'C'}}</text><text>{{item}}</text><text wx:if="{{answer === index}}">✓</text></view><button class="primary full" bindtap="nextQuestion">{{questionIndex === quizTotal - 1 ? 'Finish Quiz' : 'Next'}} →</button></view><view wx:if="{{result}}" class="quiz-result"><image src="/assets/icon-trophy.png" /><view class="result-big">{{score}}<text>分</text></view><view class="section-title">又多了一个属于你的故事！</view><text class="muted">{{score >= 80 ? '读得很认真，继续探索下一本吧。' : '再读一次，每一次都有新的发现。'}}</text><button class="primary full" data-page="report" bindtap="nav">View Report</button><button class="secondary full" bindtap="retryQuiz">Try Again</button></view></view>

  <view class="bottom-nav" wx:if="{{isTab}}"><view class="tab {{route === item.id ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="id" data-page="{{item.id}}" bindtap="nav"><view class="tab-icon"><image src="/assets/icon-{{item.icon}}.png" /></view><text>{{item.label}}</text><view wx:if="{{route === item.id}}" class="tab-dot"></view></view></view>
  <view class="modal-backdrop" wx:if="{{sheet}}" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-close" bindtap="closeSheet">×</view>
    <view wx:if="{{sheet === 'reserve'}}"><text class="eyebrow">TAKE A STORY HOME</text><view class="sheet-title">Reserve a Book</view><view class="loan-book"><image src="{{book.cover}}" class="row-cover" /><view><text class="row-title">{{book.title}}</text><text class="muted">{{book.title}}</text></view></view><view class="confirm-line"><text>Library</text><text>听阅 · 示例阅读馆</text></view><view class="confirm-line"><text>Loan period</text><text>14 days from pickup</text></view><view class="confirm-line"><text>Pickup</text><text>At the library</text></view><text class="demo-caption">这是一笔本机演示预约，不占用真实馆藏。正式借阅需绑定手机号并由馆员核销。</text><button class="primary full" bindtap="confirmReserve">Confirm Demo Reservation</button></view>
    <view wx:if="{{sheet === 'audio'}}"><image class="sheet-icon" src="/assets/icon-headphones.png" /><view class="sheet-title">故事的声音，即将到来</view><text class="description">本版已准备好播放器界面与微信音频适配器。当前书目尚未导入正式音频，因此不会模拟播放或虚增Listening。</text><button class="primary full" bindtap="closeSheet">Got it</button></view>
    <view wx:if="{{sheet === 'word'}}"><text class="eyebrow">A NEW WORD</text><view class="sheet-title word-title">{{selectedWord.surface}}</view><text class="muted">{{selectedWord.phonetic}} · {{selectedWord.partOfSpeech}}</text><view class="word-definition">{{selectedWord.definitionZh}}</view><text class="description">{{selectedWord.definitionEn}}</text><view class="info-note">{{selectedWord.example}}</view><button class="primary full" bindtap="saveWord">＋ Save Word</button></view>
    <view wx:if="{{sheet === 'queue'}}"><view class="sheet-title">Playlist</view><view class="queue-row" wx:for="{{books}}" wx:key="id" data-page="player" data-id="{{item.id}}" bindtap="nav"><image class="mini-cover" src="{{item.cover}}" /><text>{{item.title}}</text><text class="muted">{{item.time}}</text></view></view>
    <view wx:if="{{sheet === 'favorites'}}"><view class="sheet-title">Favorite Books</view><view class="queue-row" wx:for="{{favoriteBooks}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image class="mini-cover" src="{{item.cover}}" /><text>{{item.title}}</text></view><text class="description" wx:if="{{!favorites.length}}">遇见喜欢的书，点击详情页的爱心收藏。</text></view>
    <view wx:if="{{sheet === 'words'}}"><view class="sheet-title">Vocabulary</view><text class="description">{{savedWordsText}}</text></view>
    <view wx:if="{{sheet === 'branch'}}"><view class="sheet-title">听阅 · 示例阅读馆</view><text class="description">营业时间：09:30–18:30{{'\n'}}At the library、到馆归还。{{'\n'}}此馆点用于界面演示，地址和联系方式待运营配置。</text></view>
    <view wx:if="{{sheet === 'settings'}}"><view class="sheet-title">Account & Settings</view><text class="description">当前为本机演示模式，所有记录保存在本地。正式账户、手机号绑定与云同步待后端接入。</text><button class="secondary full" wx:if="{{user}}" bindtap="logout">Log out</button><button class="primary full" wx:if="{{!user}}" data-page="login" bindtap="nav">Log in / Sign up</button></view>
    <view wx:if="{{sheet === 'privacy' || sheet === 'terms'}}"><view class="sheet-title">{{sheet === 'privacy' ? '隐私政策 · 演示说明' : '用户协议 · 演示说明'}}</view><text class="description">这是本地交互原型，不提供真实登录或借阅服务。演示阅读、收藏与预约保存在当前设备，可通过清除应用数据移除。请勿输入真实个人信息。正式上线前需补全运营主体、联系方式与正式协议。</text></view>
  </view></view>
</view>
