<view class="app {{isTab ? 'is-tab' : ''}} {{route === 'player' ? 'player-theme' : ''}}">
  <view class="nav" style="padding-top: {{inset}}px">
    <block wx:if="{{!isTab}}"><view class="nav-left" wx:if="{{route !== 'ranking'}}" bindtap="back"><image class="icon" src="/assets/icon-back.png" /></view></block>
    <view class="brand" wx:if="{{route === 'home'}}"><image src="/assets/icon-book.png" class="icon" /><text>听阅</text><text class="brand-en">TINGYUE</text></view>
    <text class="nav-title" wx:if="{{route !== 'home'}}">{{title}}</text>
    <view class="wx-capsule"><text>•••</text><text class="capsule-divider">│</text><text>◉</text></view>
  </view>

  <view class="content home" wx:if="{{route === 'home'}}">
    <view class="greeting"><view><text class="eyebrow">A LITTLE READING, EVERY DAY</text><view class="greeting-title">让每个故事，陪你长大<text class="tiny-spark">✳</text></view></view></view>
    <view class="search-box" bindtap="search"><image class="icon" src="/assets/icon-search.png" /><text>Title / Series / Author / No.</text><text class="search-short">Search</text></view>
    <view class="hero" data-page="detail" data-id="peter-rabbit" bindtap="nav">
      <view class="hero-copy"><text class="hero-label">WEEKLY PICK</text><view class="hero-title"><view>走进故事里，</view><view>听见大世界。</view></view><text class="hero-desc">从《彼得兔》开始一场花园奇遇</text><view class="hero-cta">Read for Me <image src="/assets/icon-arrow-white.png" class="icon small" /></view></view>
      <view class="hero-art"><view class="hero-orbit"></view><text class="hero-star">✦</text><image src="/assets/peter.png" class="hero-book" mode="aspectFill" /><view class="hero-pill"><image class="icon tiny" src="/assets/icon-headphones.png" /> A 5:22 adventure</view><text class="hero-star second">✧</text></view>
    </view>
    <view class="quick-links">
      <view data-page="library" bindtap="nav"><view class="quick-icon sage"><image src="/assets/icon-book.png" /></view><text>Find Books</text></view>
      <view wx:if="{{isDemo}}" data-page="loans" bindtap="nav"><view class="quick-icon peach"><image src="/assets/icon-bag.png" /></view><text>Borrowed</text></view>
      <view data-page="recent" bindtap="nav"><view class="quick-icon blue"><image src="/assets/icon-headphones.png" /></view><text>Recent</text></view>
      <view data-page="report" bindtap="nav"><view class="quick-icon lavender"><image src="/assets/icon-chart.png" /></view><text>My Quizzes</text></view>
      <view data-page="ranking" bindtap="nav"><view class="quick-icon butter"><image src="/assets/icon-trophy.png" /></view><text>Rankings</text></view>
    </view>
    <view class="notice" wx:if="{{isDemo}}" data-page="loans" bindtap="nav"><image src="/assets/icon-pin.png" class="icon" /><view><text class="notice-title">把故事带回家</text><text class="notice-sub">示例阅读馆 · 09:30–18:30 · 到馆借还</text></view><image src="/assets/icon-arrow.png" class="icon small" /></view>
    <view class="section-head"><view><text class="section-title">Books</text><text class="section-en">FIND YOUR NEXT STORY</text></view><text class="more" data-page="library" bindtap="nav">View all ›</text></view>
    <text class="catalog-disclaimer">{{isDemo ? 'Sample catalog · Metadata pending verification' : 'Internal preview · Not approved for publication or sale'}}</text>
    <view class="book-row catalog-row home-book" wx:for="{{books}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">{{item.editionLabel ? 'Edition' : 'Series'}}</text><text>{{item.editionLabel || item.series}}</text></view><view class="catalog-level" wx:if="{{item.level}}"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">{{item.internalContentNumber ? 'Content ID' : 'No.'}}</text><text>{{item.internalContentNumber || item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view wx:if="{{item.pages !== null}}"><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view>
    <view class="footer-note">READ A LITTLE. GROW A LITTLE.</view>
  </view>

  <view class="content" wx:if="{{route === 'library'}}">
    <view class="page-heading">Find Books<text class="heading-caption">在这里，遇见属于你的好故事</text></view>
    <view class="search-box"><image class="icon" src="/assets/icon-search.png" /><input placeholder="Title / Series / Author / No." value="{{query}}" bindinput="inputSearch" /></view>
    <view class="filters"><view wx:for="{{filters}}" wx:key="id" class="chip {{filter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseFilter">{{item.label}}</view></view>
    <view class="list-label">{{shown.length}} books<text>Featured</text></view>
    <view class="book-row catalog-row library-card" wx:for="{{shown}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">{{item.editionLabel ? 'Edition' : 'Series'}}</text><text>{{item.editionLabel || item.series}}</text></view><view class="catalog-level" wx:if="{{item.level}}"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">{{item.internalContentNumber ? 'Content ID' : 'No.'}}</text><text>{{item.internalContentNumber || item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view wx:if="{{item.pages !== null}}"><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view>
    <view class="empty" wx:if="{{!shown.length}}"><image src="/assets/icon-search.png" /><text>没有找到这本书</text><text class="muted">试试作者名，或换一个关键词</text></view>
  </view>

  <view class="content" wx:if="{{route === 'detail'}}">
    <view class="detail-hero" style="background: {{book.color}}"><view class="detail-halo"></view><image class="detail-cover" src="{{book.cover}}" mode="aspectFill" /><text class="detail-series">{{book.editionLabel ? 'INDEPENDENT EDITION · 独立版本' : 'TINGYUE CLASSICS · 听阅精选'}}</text></view>
    <view class="detail-title-line"><view><text class="tag">{{book.editionLabel || book.series}}</text><view class="detail-title">{{book.title}}</view><text class="muted">{{book.author}}</text></view><view class="favorite {{currentFavorite ? 'selected' : ''}}" bindtap="toggleFavorite"><image src="/assets/icon-heart.png" /><text>{{currentFavorite ? 'Saved' : 'Favorite'}}</text></view></view>
    <view class="metrics"><view wx:if="{{book.level}}"><text>{{book.level}}</text><text>Level</text></view><view wx:if="{{!book.level}}"><text>{{book.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text><text>Genre</text></view><view><text>{{book.words}}</text><text>Words</text></view><view wx:if="{{book.pages !== null}}"><text>{{book.pages}}</text><text>Pages</text></view><view wx:if="{{book.pages === null}}"><text>{{book.displayDuration || book.time}}</text><text>Audio</text></view><view><text>{{book.audioSource || book.time}}</text><text>{{book.audioSource ? 'Source' : 'Listening'}}</text></view></view>
    <view class="catalog-meta detail-metadata"><view><text class="meta-label">{{book.internalContentNumber ? 'Content ID' : 'No.'}}</text><text>{{book.internalContentNumber || book.number}}</text></view><view><text class="meta-label">Words</text><text>{{book.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{book.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view wx:if="{{book.pages !== null}}"><text class="meta-label">Pages</text><text>{{book.pages}}</text></view><view wx:if="{{book.narrator}}"><text class="meta-label">Narrator</text><text>{{book.narrator}}</text></view></view>
    <view class="section-head"><text class="section-title">About this book</text><text class="tag">{{book.category === 'fiction' ? 'FICTION' : 'NONFICTION'}}</text></view><text class="description">{{book.desc}}</text>
    <view class="info-note" wx:if="{{isProduction}}"><image src="/assets/icon-clock.png" class="icon" /><text>内测试读内容 · 尚未完成内容与权利审核，不提供购买或正式发布。</text></view>
    <view class="duo-actions"><button class="primary" bindtap="startPlayer"><image src="/assets/icon-headphones-white.png" class="icon" /> Read for Me</button><button class="secondary" bindtap="openQuiz"><image src="/assets/icon-check.png" class="icon" /> Take Quiz</button></view>
    <view wx:if="{{book.chapters}}"><view class="section-head"><text class="section-title">Chapters</text><text class="tag">{{book.chapters.length}} AUDIO</text></view><view class="queue-row" wx:for="{{book.chapters}}" wx:key="id" data-id="{{item.id}}" bindtap="startChapter"><image class="mini-cover" src="{{book.cover}}" /><text>{{item.title}}</text><text class="muted">▶</text></view></view>
    <view class="purchase-panel" wx:if="{{isDemo && purchaseEligible}}"><view class="panel-top"><image class="icon" src="/assets/icon-bag.png" /><text>Buy the Story</text><text class="tag">DEMO</text></view><view class="purchase-price"><view><text class="muted">演示购书价格</text><text>{{purchasePrice}}</text></view><view wx:if="{{couponCount}}"><text class="muted">可用优惠券</text><text class="discount">-{{purchaseDiscount}}</text></view></view><text class="description">{{couponCount ? '结算时自动使用即将过期的可用优惠券。' : '邀请好友可领取 ¥5 演示优惠券。'}}</text><button class="primary full" bindtap="openPurchase" disabled="{{purchaseCompleted}}">{{purchaseCompleted ? 'Purchased · Demo' : 'Buy Demo Copy'}}</button></view>
    <view class="borrow-panel" wx:if="{{isDemo}}"><view class="panel-top"><image class="icon" src="/assets/icon-bag.png" /><text>把纸质书带回家</text><text class="tag">{{book.stock ? 'Available' : 'Unavailable'}}</text></view><view class="branch-line"><view><text>听阅 · 示例阅读馆</text><text class="muted">At the library / 归还 · 示例借期 14 天</text></view><text class="stock">{{book.stock}}<text>available</text></text></view><button class="secondary full" bindtap="openReserve" disabled="{{!book.stock}}">{{book.stock ? 'Reserve a copy' : 'No copies available'}}</button></view>
    <text class="demo-caption" wx:if="{{isDemo}}">样例书目与库存 · 正式内容上线后替换</text>
  </view>

  <view class="content" wx:if="{{isDemo && route === 'loans'}}">
    <view class="loan-summary"><view><text class="eyebrow">MY LITTLE LIBRARY</text><view class="white-title">好书，借回家慢慢读。</view><text class="soft-white">每次借阅，都是一场新的相遇</text></view><image src="/assets/icon-bag-white.png" class="summary-icon" /><view class="loan-summary-bottom"><text>Active reservations & loans</text><text>{{totalLoans}}<text class="unit"> 本</text></text></view></view>
    <view class="filters loan-filters"><view wx:for="{{loanTabs}}" wx:key="id" class="chip {{loanFilter === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="loanFilter">{{item.label}}</view></view>
    <view class="loan-card" wx:for="{{loanList}}" wx:key="id"><view class="panel-top"><text>听阅 · 示例阅读馆</text><text class="tag">{{item.label}}</text></view><view class="loan-book"><image src="{{item.book.cover}}" class="row-cover" /><view><text class="row-title">{{item.book.title}}</text><text class="muted">{{item.book.title}}</text><text class="loan-date">{{item.due}}</text></view></view><view class="loan-bottom"><text class="muted">演示预约 · 无真实占库</text><button wx:if="{{item.status === 'reserved'}}" class="small-button" data-id="{{item.id}}" bindtap="cancelLoan">Cancel</button><button wx:if="{{item.status === 'borrowed'}}" class="small-button" data-id="{{item.id}}" bindtap="renewLoan">Renew</button></view></view>
    <view class="empty illustrated-empty" wx:if="{{!loanList.length}}"><view class="empty-books"><image src="/assets/willow.png" /><image src="/assets/peter.png" /></view><text>留一个位置，给下一本好书</text><text class="muted">{{user ? '你的预约和借阅记录，会出现在这里' : '登录后，就能预约喜欢的实体书'}}</text><button class="primary" data-page="{{user ? 'library' : 'login'}}" bindtap="nav">{{user ? 'Find Books' : 'Log in to borrow'}}</button></view>
    <view class="info-note"><image src="/assets/icon-clock.png" class="icon" /><text>借阅须知：示例规则为借期 14 天，可续借 1 次。正式规则由阅读馆配置。</text></view>
  </view>

  <view class="content" wx:if="{{route === 'me'}}">
    <view class="member-card"><view class="member-top"><view class="avatar">{{user ? '阅' : 'Hi'}}</view><view><text class="member-name">{{user ? user.name : '你好，小小阅读家'}}</text><text class="soft-white">{{user ? 'A new discovery, every day' : (isDemo ? '登录后，收藏你的成长故事' : '游客学习记录保存在本机')}}</text></view><image data-sheet="settings" bindtap="showSheet" src="/assets/icon-settings-white.png" class="icon" /></view><view class="member-type">TINGYUE READER<text>Reader Card</text></view><view class="member-bottom"><text>{{user ? '演示账户 · 无正式借阅资格' : (isDemo ? '你的阅读旅程，从这里开始' : '真实账户与云同步接入中')}}</text><button wx:if="{{!user}}" class="login-mini" data-page="login" bindtap="nav">{{isDemo ? 'Log in / Sign up →' : 'Account status →'}}</button><text wx:if="{{user}}">DEMO</text></view></view>
    <view class="metrics profile-metrics"><view><text>{{stats.pieces}}</text><text>BOOKS</text></view><view><text>{{stats.words}}</text><text>WORDS</text></view><view><text>{{stats.listening}}</text><text>LISTENING</text></view></view>
    <view class="section-head"><text class="section-title">My Reading</text><text class="section-en">MY READING</text></view>
    <view class="menu-card"><view class="menu-row" data-page="report" bindtap="nav"><image src="/assets/icon-chart.png" /><text>My Quizzes</text><text class="menu-hint">Your progress</text><text>›</text></view><view class="menu-row" data-page="recent" bindtap="nav"><image src="/assets/icon-clock.png" /><text>Recent</text><text class="menu-hint">{{recent.length}} 本</text><text>›</text></view><view class="menu-row" data-sheet="favorites" bindtap="showSheet"><image src="/assets/icon-heart.png" /><text>Favorite Books</text><text class="menu-hint">{{favorites.length}} 本</text><text>›</text></view><view class="menu-row" data-sheet="words" bindtap="showSheet"><image src="/assets/icon-book.png" /><text>Vocabulary</text><text class="menu-hint">New words</text><text>›</text></view></view>
    <view class="menu-card"><view class="menu-row" wx:if="{{isDemo}}" data-page="loans" bindtap="nav"><image src="/assets/icon-bag.png" /><text>Borrowed</text><text class="menu-hint">{{totalLoans}} 本</text><text>›</text></view><view class="menu-row" wx:if="{{isDemo}}" data-page="coupons" bindtap="nav"><image src="/assets/icon-bag.png" /><text>Coupons</text><text class="menu-hint">{{couponCount}} available</text><text>›</text></view><view class="menu-row" wx:if="{{isDemo}}" data-page="invite" bindtap="nav"><image src="/assets/icon-user.png" /><text>Invite Friends</text><text class="menu-hint">{{invitationClaimed ? 'Reward claimed' : 'Get ¥5 coupon'}}</text><text>›</text></view><view class="menu-row" data-page="ranking" bindtap="nav"><image src="/assets/icon-trophy.png" /><text>Rankings</text><text class="menu-hint">Grow together</text><text>›</text></view><view class="menu-row" wx:if="{{isDemo}}" data-sheet="branch" bindtap="showSheet"><image src="/assets/icon-pin.png" /><text>My Library</text><text class="menu-hint">示例馆</text><text>›</text></view></view>
    <view class="menu-card"><view class="menu-row" data-page="notices" bindtap="nav"><image src="/assets/icon-book.png" /><text>内容来源与许可</text><text class="menu-hint">Sources &amp; licenses</text><text>›</text></view></view><view class="footer-note">{{isDemo ? '听阅 TINGYUE · FRONTEND DEMO 0.1' : '听阅 TINGYUE · INTERNAL PREVIEW'}}</view>
  </view>

  <view class="content notices-content" wx:if="{{route === 'notices'}}">
    <view class="page-heading">内容来源与许可<text class="heading-caption">Sources, attribution and release status</text></view>
    <view class="info-note"><image src="/assets/icon-clock.png" class="icon" /><text>当前内容仅供内测试读。中国大陆商业使用结论尚待外部权利审核，不代表已获准发布或收费。</text></view>
    <view class="notice-card" wx:for="{{contentNotices}}" wx:key="title"><text class="section-title">{{item.title}}</text><text class="description">{{item.body}}</text><text class="notice-url" wx:if="{{item.url}}">{{item.url}}</text></view>
    <view class="notice-card"><text class="section-title">Release gate / 发布闸门</text><text class="description">Rights status: READY_FOR_EXTERNAL_REVIEW. rightsReleaseApproved: false. publishable: false. External reviewer name, organization, date, mainland-China commercial-use conclusion, evidence IDs and restrictions are required before release.</text></view>
  </view>

  <view class="content" wx:if="{{route === 'recent'}}">
    <view class="recent-switch" aria-label="Reading list switch"><view class="{{recentMode === 'recent' ? 'active' : ''}}" data-id="recent" bindtap="chooseRecentMode">Recent</view><view class="{{recentMode === 'favorites' ? 'active' : ''}}" data-id="favorites" bindtap="chooseRecentMode">Favorites</view></view>
    <view class="page-heading">{{recentMode === 'recent' ? 'Recent' : 'Favorites'}}<text class="heading-caption">{{readingList.length}} books · {{recentMode === 'recent' ? 'Pick up where you left off' : 'Read a story you saved'}}</text></view>
    <view class="book-row catalog-row" wx:for="{{readingList}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image src="{{item.cover}}" class="catalog-cover" mode="aspectFill" /><view class="row-info"><text class="catalog-title">{{item.title}}</text><view class="catalog-by"><text class="meta-label">By</text><text>{{item.author}}</text></view><view class="catalog-series"><text class="meta-label">{{item.editionLabel ? 'Edition' : 'Series'}}</text><text>{{item.editionLabel || item.series}}</text></view><view class="catalog-level" wx:if="{{item.level}}"><text class="meta-label">Lv</text><text>{{item.level}}</text></view><view class="catalog-meta"><view><text class="meta-label">{{item.internalContentNumber ? 'Content ID' : 'No.'}}</text><text>{{item.internalContentNumber || item.number}}</text></view><view><text class="meta-label">Words</text><text>{{item.words}}</text></view><view><text class="meta-label">F/NF</text><text>{{item.category === 'fiction' ? 'Fiction' : 'Nonfiction'}}</text></view><view wx:if="{{item.pages !== null}}"><text class="meta-label">Pages</text><text>{{item.pages}}</text></view></view></view></view>
    <view class="empty" wx:if="{{!readingList.length}}"><image src="/assets/{{recentMode === 'recent' ? 'icon-headphones.png' : 'icon-heart.png'}}" /><text>{{recentMode === 'recent' ? 'Your first story is waiting' : 'Save a book you love'}}</text><text class="muted">{{recentMode === 'recent' ? 'Recently played books will appear here.' : 'Tap the heart on a book detail page.'}}</text><button class="primary" data-page="library" bindtap="nav">Find Books</button></view>
  </view>

  <view class="content" wx:if="{{isDemo && route === 'coupons'}}">
    <view class="page-heading">My Coupons<text class="heading-caption">{{couponCount}} available · 本机演示优惠</text></view>
    <view class="coupon-summary"><text>COUPON WALLET</text><view><text>{{couponCount}}</text><text>AVAILABLE</text></view><text>邀请奖励与使用记录都保存在当前设备。</text></view>
    <view class="section-head"><text class="section-title">Your Coupons</text><text class="section-en">{{coupons.length}} TOTAL</text></view>
    <view class="coupon-card {{item.available ? '' : 'disabled'}}" wx:for="{{coupons}}" wx:key="id"><view class="coupon-value"><text>{{item.amountLabel}}</text><text>{{item.conditionLabel}}</text></view><view class="coupon-info"><text>听阅购书演示券</text><text>{{item.expiresLabel}}</text><text class="coupon-status">{{item.status}}</text></view></view>
    <view class="empty" wx:if="{{!coupons.length}}"><image src="/assets/icon-bag.png" /><text>你的优惠券夹还是空的</text><text class="muted">完成一次演示邀请，即可领取 ¥5 优惠券。</text><button class="primary" data-page="invite" bindtap="nav">Invite & Get Coupon</button></view>
    <view class="section-head"><text class="section-title">Eligible Books</text><text class="section-en">DEMO STORE</text></view>
    <view class="queue-row promo-book" wx:for="{{promoBooks}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image class="mini-cover" src="{{item.cover}}" /><view><text>{{item.title}}</text><text class="muted">{{item.purchaseCompleted ? 'Purchased · Demo' : item.priceLabel}}</text></view><text>›</text></view>
  </view>

  <view class="content" wx:if="{{isDemo && route === 'invite'}}">
    <view class="page-heading">Invite Friends<text class="heading-caption">SHARE A STORY · EARN A REWARD</text></view>
    <view class="invite-hero"><text>一起读，故事会走得更远。</text><view class="invite-reward"><text>¥5</text><text>DEMO COUPON</text></view><text>演示邀请完成后，领取一张满 ¥12 可用、30 天有效的优惠券。</text></view>
    <view class="invite-steps"><view><text>1</text><view><text>Invite</text><text class="muted">演示邀请一位新读者</text></view></view><view><text>2</text><view><text>Claim</text><text class="muted">奖励自动进入 Coupons</text></view></view><view><text>3</text><view><text>Use</text><text class="muted">在演示购书结算中自动抵扣</text></view></view></view>
    <button class="primary full" bindtap="claimInviteReward" disabled="{{invitationClaimed}}">{{invitationClaimed ? 'Reward Claimed ✓' : 'Complete Demo Invite & Claim'}}</button>
    <button class="secondary full" wx:if="{{invitationClaimed}}" data-page="coupons" bindtap="nav">View My Coupons</button>
    <text class="demo-caption">这是本机功能演示，不会发送真实邀请，不会读取通讯录，也不会产生真实交易。</text>
  </view>

  <include src="./player.wxml" />

  <view class="content" wx:if="{{route === 'login'}}">
    <view class="login-art"><image src="/assets/peter.png" /><image src="/assets/garden.png" /><text>✳</text></view>
    <view class="login-title"><view>每一个故事，</view><view>都值得一起读。</view></view>
    <text class="login-desc">欢迎来到听阅 · 把成长读成一本书</text>
    <block wx:if="{{isDemo}}">
      <view class="login-tabs"><view class="{{loginMethod === 'wechat' ? 'active' : ''}}" bindtap="loginMethod" data-id="wechat">WeChat Login</view><view class="{{loginMethod === 'phone' ? 'active' : ''}}" bindtap="loginMethod" data-id="phone">Phone Login</view></view>
      <view wx:if="{{loginMethod === 'phone'}}"><view class="input-box"><text>+86</text><input type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="phoneInput" /></view><view class="input-box"><input type="number" maxlength="6" placeholder="短信验证码" value="{{code}}" bindinput="codeInput" /><text class="green" bindtap="sendCode">{{codeSent ? 'Demo: 123456' : 'Get Code'}}</text></view></view>
      <button class="primary full login-button" bindtap="login"><image wx:if="{{loginMethod === 'wechat'}}" src="/assets/icon-wechat-white.png" class="icon" />{{loginMethod === 'wechat' ? 'WeChat Login · Demo' : 'Phone Login · Demo'}}</button>
      <view class="agreement"><view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="agreement">{{agreed ? '✓' : ''}}</view><text bindtap="agreement">I agree to</text><text class="green" data-sheet="terms" bindtap="showSheet">Terms</text><text class="green" data-sheet="privacy" bindtap="showSheet">Privacy</text></view>
      <text class="demo-caption">当前为交互演示，不发送短信、不获取微信身份。{{'\n'}}请使用测试手机号，演示验证码为 123456。</text>
    </block>
    <block wx:if="{{isProduction}}">
      <view class="info-note"><image src="/assets/icon-clock.png" class="icon" /><text>真实微信登录与云同步服务接入中。当前可作为游客试读，学习记录仅保存在本机。</text></view>
      <button class="primary full login-button" disabled="{{true}}">Account service coming soon</button>
    </block>
    <view class="guest-link" data-page="home" bindtap="nav">Browse as a guest →</view>
  </view>

  <view class="content" wx:if="{{route === 'report'}}"><view class="page-heading">每一步，都算数。<text class="heading-caption">My Quizzes · {{isDemo ? '本机演示记录' : '本机游客记录'}}</text></view><view class="report-hero"><text>保持好奇，就是最好的开始</text><view class="report-large">{{stats.pieces}}<text>篇已完成</text></view><view class="report-caption">每读完一个故事，世界就大一点。</view></view><view class="report-grid"><view><text class="muted">Total Words</text><text class="report-value">{{stats.words}}</text></view><view><text class="muted">Avg. Correct</text><text class="report-value">{{stats.correct}}<text>%</text></text></view></view><view class="section-head"><text class="section-title">Your Progress</text><text class="tag">EARLY → RECENT</text></view><view class="chart-empty"><image src="/assets/icon-chart.png" /><text>慢慢积累，进步自会出现</text><text class="muted">完成至少 6 篇后，展示早期与近期表现对比</text><view class="chart-bars"><view></view><view></view><view></view><view></view><view></view><view></view></view></view><view class="section-head"><text class="section-title">Quiz History</text><text class="muted">{{results.length}} 次</text></view><view class="result-row" wx:for="{{results}}" wx:key="id"><view><text class="row-title">{{item.title}}</text><text class="muted">{{item.date}}</text></view><text class="result-score">{{item.score}}%</text></view><view class="small-empty" wx:if="{{!results.length}}">Listen to Peter Rabbit, then take your first quiz.</view></view>

  <view class="content ranking-content" wx:if="{{route === 'ranking'}}">
    <view class="rank-toolbar">
      <view class="rank-back-button" bindtap="back" aria-label="Back"><image src="/assets/icon-back.png" /></view>
      <view class="rank-control" data-sheet="campus" bindtap="showSheet"><image src="/assets/icon-pin.png" /><text>{{campusLabel}}</text><text class="control-arrow">⌄</text></view>
      <view class="rank-control" data-sheet="rankingType" bindtap="showSheet"><image src="/assets/icon-trophy.png" /><text>{{rankingTypeLabel}}</text><text class="control-arrow">⌄</text></view>
      <view class="rank-control period-control" wx:if="{{rankingType === 'week' || rankingType === 'month'}}" data-sheet="rankingPeriod" bindtap="showSheet"><image src="/assets/icon-clock.png" /><text>{{rankingType === 'week' ? selectedWeekLabel : selectedMonthLabel}}</text><text class="control-arrow">⌄</text></view>
      <view class="rank-control rank-filter-control" data-sheet="rankFilter" bindtap="showSheet"><image src="/assets/icon-settings.png" /><text>Filter</text><view class="filter-dot" wx:if="{{rankGrade !== 'all' || rankLevel !== 'all'}}"></view></view>
    </view>
    <view class="empty"><text>你的第一位对手，是昨天的自己。</text><text class="muted">当前筛选下的真实读者榜单尚未接入</text><button class="primary" data-page="library" bindtap="nav">开始今天的阅读</button></view>
    <view class="rank-self"><view class="avatar">阅</view><view><text>{{user ? user.name : '小小阅读家'}}</text><text class="muted">完整榜单上线后展示真实排名</text></view><text>—</text></view>
  </view>

  <include src="./quiz.wxml" />

  <view class="bottom-nav" wx:if="{{isTab}}"><view class="tab {{route === item.id ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="id" data-page="{{item.id}}" bindtap="nav"><view class="tab-icon"><image src="/assets/icon-{{item.icon}}.png" /></view><text>{{item.label}}</text><view wx:if="{{route === item.id}}" class="tab-dot"></view></view></view>
  <view class="modal-backdrop" wx:if="{{sheet}}" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-close" bindtap="closeSheet">×</view>
    <view wx:if="{{isDemo && sheet === 'reserve'}}"><text class="eyebrow">TAKE A STORY HOME</text><view class="sheet-title">Reserve a Book</view><view class="loan-book"><image src="{{book.cover}}" class="row-cover" /><view><text class="row-title">{{book.title}}</text><text class="muted">{{book.title}}</text></view></view><view class="confirm-line"><text>Library</text><text>听阅 · 示例阅读馆</text></view><view class="confirm-line"><text>Loan period</text><text>14 days from pickup</text></view><view class="confirm-line"><text>Pickup</text><text>At the library</text></view><text class="demo-caption">这是一笔本机演示预约，不占用真实馆藏。正式借阅需绑定手机号并由馆员核销。</text><button class="primary full" bindtap="confirmReserve">Confirm Demo Reservation</button></view>
    <view wx:if="{{isDemo && sheet === 'purchase'}}"><text class="eyebrow">DEMO CHECKOUT</text><view class="sheet-title">Buy the Story</view><view class="loan-book"><image src="{{book.cover}}" class="row-cover" /><view><text class="row-title">{{book.title}}</text><text class="muted">Digital story · Demo</text></view></view><view class="confirm-line"><text>Price</text><text>{{purchasePrice}}</text></view><view class="confirm-line"><text>Coupon</text><text class="discount">-{{purchaseDiscount}}</text></view><view class="confirm-line checkout-total"><text>Total</text><text>{{purchaseTotal}}</text></view><text class="demo-caption">确认后会在本机生成演示购买记录，并核销一张可用优惠券。不会发起真实支付。</text><button class="primary full" bindtap="confirmPurchase">Confirm Demo Purchase</button></view>
    <view wx:if="{{isDemo && sheet === 'purchaseResult'}}"><image class="sheet-icon" src="/assets/icon-check.png" /><view class="sheet-title">Purchase Complete</view><text class="description">演示购买已完成。{{purchaseResult.couponUsed ? '优惠券已成功核销。' : '本次没有使用优惠券。'}}</text><view class="purchase-result-total">{{purchaseResult.total}}</view><button class="primary full" data-page="coupons" bindtap="nav">View Coupon History</button><button class="secondary full" bindtap="closeSheet">Done</button></view>
    <view wx:if="{{sheet === 'audio'}}"><image class="sheet-icon" src="/assets/icon-headphones.png" /><view class="sheet-title">故事的声音，即将到来</view><text class="description">本版已准备好播放器界面与微信音频适配器。当前书目尚未导入正式音频，因此不会模拟播放或虚增Listening。</text><button class="primary full" bindtap="closeSheet">Got it</button></view>
    <view wx:if="{{sheet === 'word'}}"><text class="eyebrow">A NEW WORD</text><view class="sheet-title word-title">{{selectedWord.surface}}</view><text class="muted">{{selectedWord.phonetic}} · {{selectedWord.partOfSpeech}}</text><view class="word-definition">{{selectedWord.definitionZh}}</view><text class="description">{{selectedWord.definitionEn}}</text><view class="info-note">{{selectedWord.example}}</view><button class="primary full" bindtap="saveWord">＋ Save Word</button></view>
    <view wx:if="{{sheet === 'queue'}}"><view class="sheet-title">Playlist</view><view class="queue-row" wx:for="{{books}}" wx:key="id" data-page="player" data-id="{{item.id}}" bindtap="nav"><image class="mini-cover" src="{{item.cover}}" /><text>{{item.title}}</text><text class="muted">{{item.time}}</text></view></view>
    <view wx:if="{{sheet === 'favorites'}}"><view class="sheet-title">Favorite Books</view><view class="queue-row" wx:for="{{favoriteBooks}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook"><image class="mini-cover" src="{{item.cover}}" /><text>{{item.title}}</text></view><text class="description" wx:if="{{!favorites.length}}">遇见喜欢的书，点击详情页的爱心收藏。</text></view>
    <view wx:if="{{sheet === 'campus'}}"><text class="eyebrow">RANKING CAMPUS</text><view class="sheet-title">Choose Campus</view><view class="sheet-option {{campus === item.id ? 'selected' : ''}}" wx:for="{{campusOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseCampus"><text>{{item.label}}</text><text>{{campus === item.id ? '✓' : ''}}</text></view></view>
    <view wx:if="{{sheet === 'rankingType'}}"><text class="eyebrow">LEADERBOARD PERIOD</text><view class="sheet-title">Choose Ranking</view><view class="sheet-option {{rankingType === item.id ? 'selected' : ''}}" wx:for="{{rankingTypes}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRankingType"><view><text>{{item.label}}</text><text class="option-description">{{item.description}}</text></view><text>{{rankingType === item.id ? '✓' : ''}}</text></view></view>
    <view wx:if="{{sheet === 'rankingPeriod'}}"><text class="eyebrow">{{rankingType === 'week' ? 'CALENDAR WEEK' : 'CALENDAR MONTH'}}</text><view class="sheet-title">Choose {{rankingType === 'week' ? 'Week' : 'Month'}}</view><block wx:if="{{rankingType === 'week'}}"><view class="sheet-option {{selectedWeek === item.id ? 'selected' : ''}}" wx:for="{{weekOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRankingPeriod"><text>{{item.label}}</text><text>{{selectedWeek === item.id ? '✓' : ''}}</text></view></block><block wx:if="{{rankingType === 'month'}}"><view class="sheet-option {{selectedMonth === item.id ? 'selected' : ''}}" wx:for="{{monthOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRankingPeriod"><text>{{item.label}}</text><text>{{selectedMonth === item.id ? '✓' : ''}}</text></view></block></view>
    <view wx:if="{{sheet === 'rankFilter'}}"><text class="eyebrow">RANKING FILTER</text><view class="sheet-title">Grade &amp; Level</view><text class="filter-section-label">Grade</text><view class="filter-grid"><view class="filter-choice {{rankGrade === item.id ? 'selected' : ''}}" wx:for="{{gradeOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRankGrade">{{item.label}}</view></view><text class="filter-section-label">Reading Level</text><view class="filter-grid level-grid"><view class="filter-choice {{rankLevel === item.id ? 'selected' : ''}}" wx:for="{{levelOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseRankLevel">{{item.label}}</view></view><button class="primary full filter-apply" bindtap="applyRankFilter">Apply Filter</button></view>
    <view wx:if="{{sheet === 'words'}}"><view class="sheet-title">Vocabulary</view><text class="description">{{savedWordsText}}</text></view>
    <view wx:if="{{isDemo && sheet === 'branch'}}"><view class="sheet-title">听阅 · 示例阅读馆</view><text class="description">营业时间：09:30–18:30{{'\n'}}At the library、到馆归还。{{'\n'}}此馆点用于界面演示，地址和联系方式待运营配置。</text></view>
    <view wx:if="{{sheet === 'settings'}}"><view class="sheet-title">Account & Settings</view><text class="description">{{isDemo ? '当前为本机演示模式，所有记录保存在本地。' : '真实账户与云同步接入中；当前游客学习记录只保存在本机。'}}</text><button class="secondary full" wx:if="{{isDemo && user}}" bindtap="logout">Log out</button><button class="primary full" wx:if="{{!user}}" data-page="login" bindtap="nav">{{isDemo ? 'Log in / Sign up' : 'View account status'}}</button></view>
    <view wx:if="{{sheet === 'privacy' || sheet === 'terms'}}"><view class="sheet-title">{{sheet === 'privacy' ? '隐私政策 · 预览说明' : '用户协议 · 预览说明'}}</view><text class="description">{{isDemo ? '这是本地交互原型，不提供真实登录或借阅服务。演示记录保存在当前设备。' : '当前为内测试读版本，不提供真实登录、交易或借阅。游客学习记录保存在当前设备，可通过清除应用数据移除。正式上线前将补全运营主体、联系方式与正式协议。'}}</text></view>
  </view></view>
</view>
