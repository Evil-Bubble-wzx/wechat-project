<view class="player-content reader-content" wx:if="{{route === 'player'}}">
  <view class="reader-book-title">{{book.title}}</view>
  <view class="reader-cover-wrap"><image class="reader-cover" src="{{book.cover}}" mode="aspectFit" /><text class="reader-chapter">{{book.chapterTitle || book.author}}</text></view>
  <view class="reader-subtitles" wx:if="{{subtitle}}">
    <view class="reader-row {{item.active ? 'reader-row-active' : ''}} {{item.edge ? (item.slot === 0 ? 'reader-row-fade-top' : 'reader-row-fade-bottom') : ''}}" wx:for="{{subtitleRows}}" wx:key="slot">
      <view class="reader-row-text"><block wx:for="{{item.tokens}}" wx:for-item="token" wx:key="id"><text wx:if="{{token.vocabKey}}" class="reader-word" data-word="{{token.surface}}" data-vocab-key="{{token.vocabKey}}" data-cue-index="{{item.cueIndex}}" bindtap="word">{{token.surface}}</text><text wx:if="{{!token.vocabKey}}">{{token.surface}}</text></block></view>
    </view>
  </view>
  <view class="reader-subtitles reader-hidden" wx:if="{{!subtitle}}"><text>字幕已关闭 · 点击下方按钮重新显示</text></view>
  <view class="reader-panel">
    <view class="reader-panel-top"><view bindtap="speed">{{rate}}× 倍速</view><view bindtap="toggleSubtitle">{{subtitle ? '✓ 自动跟随 · 隐藏字幕' : '显示字幕'}}</view></view>
    <slider min="0" max="{{book.duration}}" value="{{position}}" activeColor="#497653" backgroundColor="#dce5d5" block-size="16" bindchange="seek" />
    <view class="reader-time"><text>{{formatted}}</text><text>{{duration}}</text></view>
    <view class="reader-controls"><view class="reader-step" data-step="-1" bindtap="stepSentence"><text>‹</text><text>上一句</text></view><button class="play-button" bindtap="togglePlay"><image src="/assets/icon-{{playing ? 'pause' : 'play'}}.png" /></button><view class="reader-step" data-step="1" bindtap="stepSentence"><text>›</text><text>下一句</text></view></view>
    <view class="reader-panel-bottom"><text>{{book.localAudio || book.audioUrl ? '音频已导入 · ' + book.audioSource : '音频待导入'}}</text><text bindtap="openQuiz">{{book.hasQuiz || book.workId === 'peter-rabbit' ? '阅读小测 ›' : ''}}</text></view>
  </view>
</view>
