.report-hero { padding:34rpx; background:#e7ecdc; border-radius:26rpx; font-size:22rpx; color:#69815b; }.report-large { margin-top:10rpx; color:#386849; font-family:Georgia,serif; font-size:108rpx; line-height:1.3; }.report-large>text { font-family:sans-serif; font-size:24rpx; padding-left:25rpx; }.report-caption { font-size:20rpx; margin-top:10rpx; }.report-grid { display:flex; gap:22rpx; margin-top:22rpx; }.report-grid>view { flex:1; background:white; padding:28rpx; border:1rpx solid #e4eadc; border-radius:22rpx; }.report-value { display:block; font-size:52rpx; font-weight:600; color:#42724f; margin-top:12rpx; }.report-value>text { font-size:26rpx; }.chart-empty { background:white; border:1rpx solid #e4eadc; border-radius:22rpx; padding:30rpx 20rpx 0; text-align:center; overflow:hidden; }.chart-empty>image { width:44rpx; height:44rpx; margin:0 auto 15rpx; opacity:.5; }.chart-empty>text { display:block; font-size:23rpx; }.chart-empty>.muted { font-size:19rpx; margin-top:8rpx; }.chart-bars { display:flex; justify-content:space-evenly; align-items:flex-end; height:150rpx; padding:0 35rpx; margin-top:20rpx; opacity:.55; }.chart-bars>view { width:44rpx; height:45%; background:#dee7d2; border-radius:8rpx 8rpx 0 0; }.chart-bars>view:nth-child(2) { height:55%; }.chart-bars>view:nth-child(3) { height:50%; }.chart-bars>view:nth-child(4) { height:73%; }.chart-bars>view:nth-child(5) { height:82%; }.chart-bars>view:nth-child(6) { height:98%; }.small-empty { padding:35rpx 0; color:#909e83; text-align:center; font-size:22rpx; }.result-row { display:flex; justify-content:space-between; align-items:center; padding:24rpx 0; border-bottom:1rpx solid #e5eadf; gap:20rpx; }.result-score { color:#4b7c57; font-size:35rpx; }
.rank-header { text-align:center; background:#f0e8d3; border-radius:26rpx; padding:35rpx 20rpx; }.rank-title { font-family:"Songti SC","SimSun",serif; font-size:36rpx; margin:20rpx 0 14rpx; }.rank-header>image { width:100rpx; height:100rpx; margin:30rpx auto 0; opacity:.6; }.rank-self { display:flex; align-items:center; gap:20rpx; padding:26rpx; background:#e8eedf; border-radius:20rpx; }.rank-self>text:last-child { margin-left:auto; }.rank-self .muted { font-size:18rpx; margin-top:5rpx; }
.quiz-content { padding-top:40rpx; }.quiz-heading { display:flex; justify-content:space-between; align-items:center; margin-top:22rpx; font-size:36rpx; font-weight:600; }.quiz-heading>text { font-size:22rpx; color:#8a997d; }.progress-track { height:10rpx; background:#e0e7d8; border-radius:5rpx; margin:30rpx 0 44rpx; overflow:hidden; }.progress-track>view { height:100%; background:#64915e; transition:width .2s; }.question { font-family:Georgia,serif; font-size:48rpx; line-height:1.3; margin:26rpx 0 20rpx; }.answer { display:flex; align-items:center; gap:20rpx; padding:24rpx; border:2rpx solid #e4e9dc; background:white; border-radius:22rpx; margin-top:23rpx; font-size:28rpx; min-height:100rpx; }.answer:first-of-type { margin-top:35rpx; }.answer.selected { border-color:#51855b; background:#e8eedf; }.answer-letter { width:48rpx; height:48rpx; border-radius:50%; background:#f0f3e9; display:flex; align-items:center; justify-content:center; color:#829476; font-size:24rpx; }.answer>text:last-child:not(:nth-child(2)) { margin-left:auto; color:#4d7a52; }.quiz-content .full { margin-top:40rpx; }.quiz-result { text-align:center; padding:50rpx 0; }.quiz-result>image { width:130rpx; height:130rpx; margin:auto; }.result-big { font-family:Georgia,serif; color:#47764d; font-size:140rpx; margin:20rpx 0; }.result-big>text { font-size:35rpx; padding-left:10rpx; }.quiz-result>.muted { margin-top:20rpx; }
.modal-backdrop { position:fixed; inset:0; background:#12281f66; z-index:50; display:flex; align-items:flex-end; backdrop-filter:blur(5rpx); }.sheet { color:#253a32; background:#fbfcf8; width:100%; padding:30rpx 40rpx calc(40rpx + env(safe-area-inset-bottom)); border-radius:34rpx 34rpx 0 0; max-height:88vh; overflow-y:auto; position:relative; text-align:left; }.sheet-handle { width:70rpx; height:7rpx; background:#d4decb; border-radius:6rpx; margin:-10rpx auto 34rpx; }.sheet-close { position:absolute; top:25rpx; right:28rpx; font-size:42rpx; color:#8f9d84; padding:0 10rpx; }.sheet-title { font-size:38rpx; font-weight:600; margin:14rpx 0 28rpx; }.sheet-icon { width:65rpx; height:65rpx; margin:10rpx 0 25rpx; }.confirm-line { display:flex; justify-content:space-between; padding:21rpx 0; border-bottom:1rpx solid #e8edde; font-size:24rpx; }.confirm-line>text:first-child { color:#8a9880; }.word-title { font-family:Georgia,serif; font-size:70rpx; margin-bottom:8rpx; }.word-definition { font-size:30rpx; margin:30rpx 0 15rpx; }.queue-row { display:flex; align-items:center; gap:20rpx; padding:17rpx 0; border-bottom:1rpx solid #e6ecdd; }.mini-cover { width:60rpx; height:84rpx; border-radius:3rpx; }.queue-row>.muted { margin-left:auto; font-size:20rpx; }
@media (prefers-reduced-motion:reduce) { view { transition:none!important; } }
.wx-capsule { visibility:hidden; }
.muted,.description { color:#65745f; }
.notice-sub,.tile-sub,.tile-meta,.row-meta,.heading-caption,.list-label,.menu-hint,.demo-caption { color:#6c7a64; }
.notice-sub,.tile-sub,.tile-meta,.row-meta,.tag,.list-label,.menu-hint,.demo-caption,.branch-line .muted { font-size:22rpx; }
.tab { font-size:24rpx; }
.sheet-close { width:88rpx; height:88rpx; text-align:center; }
.nav-left { min-height:88rpx; }
.agreement { font-size:22rpx; }
.login-title { white-space:pre-line; }
.tab { width:33.333333%; }
.quick-links>view { font-size:20rpx; min-width:0; flex:1; }
.quick-links { gap:8rpx; }
.hero-cta { gap:12rpx; padding:0 18rpx; }
.search-short { display:none; }
.catalog-disclaimer { display:block; font-size:20rpx; color:#7b8774; margin-bottom:14rpx; }
.catalog-row { align-items:flex-start; gap:24rpx; padding:28rpx 0; }
.catalog-cover { width:164rpx; height:230rpx; border-radius:5rpx; box-shadow:2rpx 5rpx 10rpx #00000012; margin-top:5rpx; }
.catalog-title { display:block; font-size:28rpx; font-weight:650; line-height:1.35; overflow-wrap:anywhere; }
.catalog-by,.catalog-series,.catalog-level { display:flex; align-items:baseline; gap:12rpx; font-size:23rpx; line-height:1.45; margin-top:7rpx; }
.catalog-series { font-size:21rpx; color:#667860; }
.meta-label { color:#7a8573; font-weight:400; flex-shrink:0; }
.catalog-level>text:last-child { color:#326748; font-weight:600; }
.catalog-meta { display:grid; grid-template-columns:1fr 1fr; gap:6rpx 15rpx; margin-top:11rpx; font-size:22rpx; color:#52634b; }
.catalog-meta>view { display:flex; align-items:baseline; gap:12rpx; min-width:0; }
.catalog-meta .meta-label { min-width:55rpx; }
.catalog-meta>view:nth-child(even) .meta-label { min-width:65rpx; }
.catalog-row.library-card { background:transparent; border:0; border-bottom:1rpx solid #e4e9de; border-radius:0; margin:0; }
.detail-metadata { padding:18rpx 0; border-bottom:1rpx solid #e3e8dc; }
.library-card .catalog-title { font-size:28rpx; }
.filters { flex-wrap:wrap; }
