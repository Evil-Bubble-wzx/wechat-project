{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tingyue.local/schema/vocab-decisions-v1.json",
  "title": "Tingyue vocabulary editorial review",
  "type": "object",
  "required": ["schemaVersion", "pieceId", "status", "sourceCueSha256", "entries", "signoff"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pieceId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["machine_draft", "draft", "completed"] },
    "sourceCueSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reviewId", "id", "sourceKey", "normalized", "occurrences", "action", "senses", "confirmed"],
        "properties": {
          "reviewId": { "type": "string", "pattern": "^V[0-9]{3,}$" },
          "id": { "type": "string", "pattern": "^ve-[a-f0-9]{12}$" },
          "sourceKey": { "type": "string", "minLength": 1 },
          "normalized": { "type": "string", "minLength": 1 },
          "action": { "enum": [null, "approve", "excludeProperNoun"] },
          "exclusionReason": { "type": ["string", "null"] },
          "confirmed": { "type": "boolean" },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["cueId", "tokenId", "surface", "cueText", "startMs", "endMs"]
            }
          },
          "senses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["lemma", "partOfSpeech", "senseNo", "phonetic", "definitionEn", "definitionZh", "occurrenceTokenIds"],
              "properties": {
                "lemma": { "type": ["string", "null"] },
                "partOfSpeech": {
                  "enum": [null, "noun", "verb", "adjective", "adverb", "pronoun", "determiner", "preposition", "conjunction", "auxiliary", "interjection", "numeral", "particle", "other"]
                },
                "senseNo": { "type": "integer", "minimum": 1 },
                "phonetic": { "type": ["string", "null"] },
                "definitionEn": { "type": ["string", "null"] },
                "definitionZh": { "type": ["string", "null"] },
                "occurrenceTokenIds": { "type": "array", "items": { "type": "string" } },
                "evidenceRefs": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "signoff": {
      "type": "object",
      "required": ["reviewer", "reviewedAt"],
      "properties": {
        "reviewer": { "type": ["string", "null"] },
        "reviewedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
