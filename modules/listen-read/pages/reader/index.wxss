.reader { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.reading-top { padding: 24rpx 34rpx 8rpx; flex-shrink: 0; }
.reading-heading { display: flex; align-items: center; gap: 14rpx; }
.reading-book-title { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: #304D3D; font-family: Georgia, 'Times New Roman', serif; font-size: 35rpx; font-weight: 700; }
.chapter-menu { flex-shrink: 0; font-size: 23rpx; color: #70845F; padding: 12rpx; }
.cover-stage { height: 290rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.reading-cover { width: 200rpx; height: 250rpx; border-radius: 12rpx; }
.cover-chapter { max-width: 90%; color: #9AA68F; font-size: 21rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.subtitle-stage { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; padding: 4rpx 32rpx 10rpx; }
.subtitle-row { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; width: 100%; padding: 0 18rpx; border-left: 5rpx solid transparent; border-radius: 12rpx; color: #71806E; }
.subtitle-text { width: 100%; overflow: hidden; white-space: pre; font-family: Georgia, 'Times New Roman', serif; font-size: 30rpx; line-height: 1.5; }
.subtitle-active { background: #EAF0DC; border-left-color: #75A071; color: #345B3E; font-weight: 650; }
.subtitle-fade-top { opacity: .7; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 85%); mask-image: linear-gradient(to bottom, transparent, #000 85%); }
.subtitle-fade-bottom { opacity: .7; -webkit-mask-image: linear-gradient(to bottom, #000 15%, transparent); mask-image: linear-gradient(to bottom, #000 15%, transparent); }
.word-token { padding: 3rpx 0; }
.player-panel { background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; border-top: 1rpx solid #E6EADC; flex-shrink: 0; padding: 22rpx 38rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -6rpx 30rpx rgba(80,96,58,.03); }.player-meta { font-size: 22rpx; color: #8C987D; }.player-meta button { padding: 8rpx 0; }.follow-active { color: #5D8150; }.seekbar { margin: 16rpx 0 0; }.time-row { font-size: 20rpx; color: #9BA68A; margin-top: -4rpx; }.transport { display: flex; align-items: center; justify-content: center; gap: 70rpx; margin-top: 8rpx; }.transport-side { display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: #94A083; font-size: 19rpx; width: 80rpx; padding: 10rpx 0; }.transport-side image { width: 40rpx; height: 40rpx; }.play-button { flex: 0 0 110rpx; width: 110rpx; min-width: 110rpx; max-width: 110rpx; height: 110rpx; min-height: 110rpx; max-height: 110rpx; padding: 0; background: #497653; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 14rpx #E0E8D8; }.play-button image { width: 53rpx; height: 53rpx; }.player-bottom { margin-top: 17rpx; font-size: 20rpx; color: #AAB29D; }.player-bottom button { color: #688255; padding: 10rpx 0; font-size: 23rpx; }.audio-error { font-size: 23rpx; color: #B36D4A; padding: 10rpx 0; }
.word-label { color: #8D9A7D; font-size: 24rpx; }.word-name { font-family: Georgia, serif; font-size: 64rpx; color: #3D6644; font-weight: 700; }.word-phonetic { color: #9AA389; margin-top: 12rpx; font-size: 25rpx; }.word-phonetic text { font-size: 21rpx; margin-left: 18rpx; }.definition { font-size: 33rpx; margin-top: 29rpx; }.definition text { font-size: 23rpx; color: #8E9C7D; margin-right: 16rpx; }.word-en { color: #8C9780; font-size: 25rpx; line-height: 1.6; margin-top: 17rpx; }.example { background: #F1F3E9; border-radius: 22rpx; padding: 25rpx; margin: 28rpx 0; }.example .example-label { color: #A4AF93; font-size: 20rpx; }.example view { color: #5D7350; font-family: Georgia, serif; font-size: 29rpx; line-height: 1.7; margin: 9rpx 0; }.example text { color: #98A186; font-size: 24rpx; }.word-sheet .footer-note { margin-top: 20rpx; }.chapter-option { padding: 28rpx 0; border-bottom: 1rpx solid #ECF0E2; gap: 24rpx; }.chapter-option>text { font-size: 34rpx; color: #9FAF8A; }.chapter-option>view { flex: 1; font-size: 28rpx; }.chapter-option>view>text { display: block; color: #9AA68A; font-size: 22rpx; margin-top: 8rpx; }
