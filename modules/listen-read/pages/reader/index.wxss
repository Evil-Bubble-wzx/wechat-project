.reader { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.reading-top { padding: 24rpx 34rpx; gap: 20rpx; flex-shrink: 0; }
.reading-cover { width: 66rpx; height: 82rpx; border-radius: 8rpx; }.reading-title { flex: 1; min-width: 0; }.reading-title view { font-size: 29rpx; font-weight: 700; }.reading-title text { display: block; font-size: 21rpx; color: #949E87; margin-top: 8rpx; }.chapter-menu { font-size: 23rpx; color: #70845F; padding: 12rpx; }
.reading-tools { padding: 15rpx 36rpx; border-top: 1rpx solid #EAEDDF; border-bottom: 1rpx solid #EAEDDF; flex-shrink: 0; color: #94A184; font-size: 22rpx; }.live-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #A2B583; margin-right: 12rpx; }.translation-button { background: #EDF0E5; border-radius: 12rpx; font-size: 21rpx; padding: 9rpx 16rpx; color: #96A185; }.translation-button.enabled { background: #DAE6CC; color: #55764B; }
.transcript { flex: 1; height: 0; min-height: 0; }.transcript-inner { padding: 34rpx 30rpx 35rpx; }.chapter-label { font-size: 18rpx; letter-spacing: 4rpx; color: #A9B497; margin-left: 22rpx; }.transcript-heading { font-family: Georgia, serif; font-size: 41rpx; font-weight: 700; margin: 14rpx 22rpx; }.reading-hint { color: #ADB59F; font-size: 21rpx; margin: 0 22rpx 28rpx; }
.sentence { padding: 23rpx 25rpx; border-left: 5rpx solid transparent; border-radius: 0 18rpx 18rpx 0; margin-bottom: 8rpx; transition: background .2s; }.sentence-english { font-family: Georgia, 'Times New Roman', serif; font-size: 37rpx; line-height: 1.65; color: #66735D; white-space: pre-wrap; }.sentence-active { background: #E9EFD9; border-left-color: #7E9A60; }.sentence-active .sentence-english { color: #3D6439; }.word-token { padding: 4rpx 0; }.sentence-chinese { color: #97A287; font-size: 24rpx; line-height: 1.8; margin-top: 10rpx; }.end-mark { text-align: center; color: #C2CCA9; margin-top: 20rpx; }.chapter-finished { background: #F0F2E5; border-radius: 20rpx; text-align: center; padding: 26rpx; margin-top: 20rpx; }.chapter-finished>view { font-size: 28rpx; font-weight: 650; }.chapter-finished>text { display: block; font-size: 23rpx; color: #8A977C; margin: 12rpx 0; }.chapter-finished .secondary { min-height: 66rpx; font-size: 24rpx; }
.player-panel { background: #FFFEFA; border-radius: 32rpx 32rpx 0 0; border-top: 1rpx solid #E6EADC; flex-shrink: 0; padding: 22rpx 38rpx calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -6rpx 30rpx rgba(80,96,58,.03); }.player-meta { font-size: 22rpx; color: #8C987D; }.player-meta button { padding: 8rpx 0; }.follow-active { color: #5D8150; }.seekbar { margin: 16rpx 0 0; }.time-row { font-size: 20rpx; color: #9BA68A; margin-top: -4rpx; }.transport { display: flex; align-items: center; justify-content: center; gap: 70rpx; margin-top: 8rpx; }.transport-side { display: flex; flex-direction: column; align-items: center; gap: 5rpx; color: #94A083; font-size: 19rpx; width: 80rpx; padding: 10rpx 0; }.transport-side image { width: 40rpx; height: 40rpx; }.play-button { flex: none; width: 110rpx; height: 110rpx; padding: 0; background: #497653; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 14rpx #E0E8D8; }.play-button image { width: 53rpx; height: 53rpx; }.player-bottom { margin-top: 17rpx; font-size: 20rpx; color: #AAB29D; }.player-bottom button { color: #688255; padding: 10rpx 0; font-size: 23rpx; }.audio-error { font-size: 23rpx; color: #B36D4A; padding: 10rpx 0; }
.word-label { color: #8D9A7D; font-size: 24rpx; }.word-name { font-family: Georgia, serif; font-size: 64rpx; color: #3D6644; font-weight: 700; }.word-phonetic { color: #9AA389; margin-top: 12rpx; font-size: 25rpx; }.word-phonetic text { font-size: 21rpx; margin-left: 18rpx; }.definition { font-size: 33rpx; margin-top: 29rpx; }.definition text { font-size: 23rpx; color: #8E9C7D; margin-right: 16rpx; }.word-en { color: #8C9780; font-size: 25rpx; line-height: 1.6; margin-top: 17rpx; }.example { background: #F1F3E9; border-radius: 22rpx; padding: 25rpx; margin: 28rpx 0; }.example .example-label { color: #A4AF93; font-size: 20rpx; }.example view { color: #5D7350; font-family: Georgia, serif; font-size: 29rpx; line-height: 1.7; margin: 9rpx 0; }.example text { color: #98A186; font-size: 24rpx; }.word-sheet .footer-note { margin-top: 20rpx; }.chapter-option { padding: 28rpx 0; border-bottom: 1rpx solid #ECF0E2; gap: 24rpx; }.chapter-option>text { font-size: 34rpx; color: #9FAF8A; }.chapter-option>view { flex: 1; font-size: 28rpx; }.chapter-option>view>text { display: block; color: #9AA68A; font-size: 22rpx; margin-top: 8rpx; }
