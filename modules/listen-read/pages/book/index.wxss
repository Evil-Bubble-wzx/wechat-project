.book-stage { position: relative; height: 460rpx; display: flex; align-items: center; flex-direction: column; padding-top: 36rpx; overflow: hidden; }.stage-ring { position: absolute; width: 530rpx; height: 530rpx; border: 1rpx solid rgba(255,255,255,.45); border-radius: 50%; top: 58rpx; }.detail-cover { width: 248rpx; height: 310rpx; border-radius: 10rpx; box-shadow: 14rpx 19rpx 30rpx rgba(46,56,34,.19); transform: rotate(-5deg); }.stage-caption { margin-top: 28rpx; font-size: 17rpx; letter-spacing: 5rpx; color: #7E8D71; }.book-body { position: relative; margin-top: -28rpx; border-radius: 30rpx 30rpx 0 0; background: #FAF9F5; padding: 36rpx 36rpx 185rpx; }.age { color: #8B9683; font-size: 22rpx; }.book-title { font-family: Georgia, serif; font-size: 49rpx; font-weight: 700; margin: 24rpx 0 12rpx; }.book-zh { font-size: 30rpx; font-weight: 650; }.book-zh text { display: block; font-size: 24rpx; font-weight: 400; color: #8C9782; margin-top: 12rpx; }.tags { display: flex; gap: 12rpx; margin-top: 22rpx; }.tags text { padding: 7rpx 13rpx; border: 1rpx solid #E7E9DF; border-radius: 8rpx; font-size: 20rpx; color: #839177; }.intro-title { margin-top: 38rpx; font-size: 30rpx; }.intro { color: #818C78; font-size: 25rpx; line-height: 1.85; margin-top: 17rpx; }.learning { background: #EFF1E6; padding: 17rpx 20rpx; gap: 12rpx; color: #6C805D; font-size: 22rpx; border-radius: 14rpx; margin-top: 22rpx; }.chapter { min-height: 142rpx; padding: 24rpx; gap: 22rpx; border-bottom: 1rpx solid #ECEFE4; }.chapter:last-child { border: 0; }.chapter-number { font-family: Georgia, serif; color: #A6B594; font-size: 34rpx; }.chapter-copy { flex: 1; }.chapter-copy view { font-size: 27rpx; font-weight: 600; }.chapter-copy text { display: block; color: #9AA48F; font-size: 21rpx; margin-top: 10rpx; }.free-tag,.done-tag { font-size: 19rpx; color: #648650; background: #ECF1E2; padding: 5rpx 9rpx; border-radius: 7rpx; }.purchase-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 22rpx 36rpx calc(22rpx + env(safe-area-inset-bottom)); background: #FFFEFA; border-top: 1rpx solid #EBEDE3; display: flex; gap: 20rpx; }.trial-button { width: 240rpx; }.purchase-button { flex: 1; }.order { gap: 28rpx; margin: 28rpx 0; }.order image { width: 115rpx; height: 145rpx; border-radius: 10rpx; }.order-title { font-size: 31rpx; font-weight: 700; margin-bottom: 10rpx; }.order-price { font-size: 39rpx; color: #AB744D; font-weight: 700; margin-top: 16rpx; }.demo-note { font-size: 24rpx; line-height: 1.7; color: #928570; background: #F7F0E2; border-radius: 16rpx; padding: 24rpx; margin-bottom: 28rpx; }
