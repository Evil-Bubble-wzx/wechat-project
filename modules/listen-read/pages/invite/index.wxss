.invite-page { padding-top: 40rpx; }.invite-page .heading { margin: 15rpx 0 38rpx; }.invite-hero { background: #dbe8cb; border-radius: 34rpx; padding: 45rpx; text-align: center; font-size: 36rpx; font-weight: 700; color: #426d4a; }.gift { font-size: 80rpx; }.invite-hero text { display: block; font-size: 27rpx; margin-top: 15rpx; }.rule { padding: 32rpx; margin: 30rpx 0; }.rule view:not(:first-child) { color: #849272; margin-top: 13rpx; line-height: 1.6; font-size: 25rpx; }.demo-button { margin-top: 20rpx; }.success { color: #507b4d; text-align: center; margin: 24rpx 0; font-size: 25rpx; }.plain-link { background: none; color: #51794d; margin: 25rpx auto; font-size: 27rpx; }
.reward { padding: 28rpx; margin-top: 24rpx; }.reward view:not(:first-child) { margin-top: 16rpx; color: #507b4d; }.reward text { display: block; color: #919d86; margin-top: 15rpx; font-size: 22rpx; }
