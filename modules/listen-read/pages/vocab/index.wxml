<view class="page"><view class="eyebrow">MY WORD GARDEN</view><view class="heading">每个新词，都是小种子</view><view class="subheading">已经种下 {{words.length}} 颗单词种子，常回来看看吧。</view>
  <view wx:if="{{!words.length}}" class="empty card"><image src="/assets/avatar.png"/><view class="empty-title">花园正在等第一颗种子</view><view class="subheading">听故事时点击单词，再点“加入单词花园”，
就可以在这里复习啦。</view><button class="secondary" bindtap="discover">去听一个故事</button></view>
  <view class="word-list"><view wx:for="{{words}}" wx:key="key" class="word-card card" data-key="{{item.key}}" bindtap="open"><view class="between"><view class="vocab-word">{{item.surface}}<text wx:if="{{item.ph}}">{{item.ph}}</text></view><image class="icon" src="/assets/icons/leaf-on.png"/></view><view class="vocab-definition"><text wx:if="{{item.pos}}">{{item.pos}}</text>{{item.zh}}</view><view class="vocab-source">来自《{{item.bookTitle}}》<text>查看原句 ›</text></view></view></view>
  <view wx:if="{{selected}}" class="modal-mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="between"><view class="vocab-word">{{selected.surface}}</view><button class="close" bindtap="close">×</button></view><view class="vocab-definition">{{selected.pos}} {{selected.zh}}</view><view wx:if="{{selected.en}}" class="vocab-english">{{selected.en}}</view><view class="sentence-box"><view>{{selected.sentence}}</view><text wx:if="{{selected.translation}}">{{selected.translation}}</text></view><button class="primary" bindtap="listen">回到故事里听一听</button><button class="remove-word" bindtap="remove">移出这个单词</button></view></view>
</view>
<mini-player/>
