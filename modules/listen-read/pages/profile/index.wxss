.profile { gap: 26rpx; padding: 15rpx 0 36rpx; }.profile>image { width: 118rpx; height: 118rpx; border-radius: 50%; border: 6rpx solid white; }.profile-name { font-size: 38rpx; font-weight: 700; margin-bottom: 12rpx; }.profile-name text { font-size: 18rpx; font-weight: 400; color: #98A286; background: #EDF1E4; border-radius: 7rpx; margin-left: 20rpx; padding: 6rpx 9rpx; vertical-align: middle; }.growth { padding: 32rpx; }.growth .section-title { font-size: 30rpx; }.stats { display: flex; justify-content: space-around; text-align: center; margin: 38rpx 0 30rpx; }.stats text { font-size: 58rpx; color: #55774B; font-family: Georgia, serif; }.stats view view { font-size: 22rpx; color: #9EA88C; margin-top: 8rpx; }.listened { border-top: 1rpx solid #EEF0E5; padding-top: 23rpx; gap: 14rpx; color: #8B997A; font-size: 22rpx; }.menu { margin-top: 30rpx; padding: 0 28rpx; }.menu-row { padding: 25rpx 0; border-bottom: 1rpx solid #EFF0E8; text-align: left; gap: 18rpx; }.menu-row:last-child { border: 0; }.menu-row>text:nth-child(2) { flex: 1; font-size: 27rpx; }.menu-value { color: #A1AA95; font-size: 22rpx; }.menu-icon { width: 60rpx; height: 60rpx; border-radius: 17rpx; background: #EAF0DF; display: flex; align-items: center; justify-content: center; }.menu-icon image { width: 35rpx; height: 35rpx; }.warm { background: #F1EBD7; }.cream { background: #F3E6D7; }.parent-note { position: relative; background: #EAEEDD; border-radius: 26rpx; padding: 32rpx; margin-top: 30rpx; }.parent-note>view:nth-child(2) { font-size: 34rpx; color: #60754F; font-weight: 650; line-height: 1.55; margin-top: 20rpx; }.parent-note>text { color: #98A484; font-size: 24rpx; line-height: 1.8; display: block; margin-top: 18rpx; }.parent-note image { position: absolute; width: 82rpx; height: 82rpx; right: 38rpx; top: 75rpx; opacity: .25; }.about { font-size: 23rpx; text-align: center; color: #9BA48C; margin-top: 30rpx; padding: 20rpx; }.footer-note { margin-top: 5rpx; }.report { padding: 30rpx; margin-top: 24rpx; }.report>view:not(:first-child) { font-size: 25rpx; line-height: 1.8; color: #7D8E6D; margin-top: 18rpx; }.report>text { font-size: 22rpx; color: #A2AC92; display: block; line-height: 1.7; margin-top: 18rpx; }.about-copy { font-size: 27rpx; color: #7F8B73; line-height: 1.9; margin: 25rpx 0 35rpx; }
