<view wx:if="{{current}}" class="mini {{tab ? 'tab' : ''}} {{raised ? 'raised' : ''}}">
  <view class="mini-copy" bindtap="open"><view class="mini-title">{{current.title}}</view><view class="mini-time">{{clock}} / {{total}} · {{current.background ? '支持后台播放' : '小窗继续听'}}</view></view>
  <view class="mini-toggle" catchtap="toggle" aria-role="button" aria-label="播放或暂停">{{current.state === 'playing' || current.state === 'loading' ? 'Ⅱ' : '▶'}}</view>
</view>
