.mini { position: fixed; z-index: 20; left: 24rpx; right: 24rpx; bottom: calc(20rpx + env(safe-area-inset-bottom)); min-height: 104rpx; border-radius: 26rpx; background: #315f49; color: white; box-shadow: 0 12rpx 35rpx #315f4940; display: flex; align-items: center; padding: 12rpx 18rpx 12rpx 27rpx; }
.mini.tab { bottom: calc(112rpx + env(safe-area-inset-bottom)); }.mini.raised { bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.mini-copy { flex: 1; min-width: 0; }.mini-title { font-size: 27rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.mini-time { font-size: 20rpx; opacity: .82; margin-top: 8rpx; }
.mini-toggle { flex: 0 0 76rpx; width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 76rpx; min-height: 76rpx; max-height: 76rpx; border-radius: 50%; background: #f2f4df; color: #315f49; font-size: 30rpx; display: flex; align-items: center; justify-content: center; }
